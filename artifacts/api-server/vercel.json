{
  "version": 2,
  "installCommand": "cd ../.. && pnpm install",
  "buildCommand": "pnpm run build",
  "framework": null,
  "outputDirectory": "public",
  "functions": {
    "api/index.js": {
      "includeFiles": "dist/**"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api"
    }
  ]
}
